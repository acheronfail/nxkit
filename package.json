{
  "type": "module",
  "name": "nxkit",
  "productName": "NXKit",
  "version": "0.1.0",
  "description": "Utilities for Nintendo Switch (NX) Homebrew",
  "main": ".vite/build/src_main_index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prestart": "tsx scripts/resources.ts",
    "postinstall": "tsx scripts/resources.ts",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx src",
    "format": "prettier --write --list-different {src,scripts,*.ts,*.js,*.json}",
    "format:check": "prettier --check {src,scripts,*.ts,*.js,*.json}",
    "test": "node scripts/npm-run.js test:vitest:run test:types:tsc test:types:svelte lint --windows-allow-fail format:check",
    "test:vitest": "vitest --config vite.test.config.ts",
    "test:vitest:run": "vitest --config vite.test.config.ts run",
    "test:types:tsc": "tsc -p tsconfig.json",
    "test:types:svelte": "svelte-check --tsconfig tsconfig.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron-forge/plugin-vite": "^7.8.0",
    "@electron-forge/publisher-github": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@eslint/compat": "^1.2.8",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/emscripten": "^1.39.13",
    "@types/node": "^20.17.25",
    "@types/w3c-web-usb": "^1.0.10",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "electron": "35.2.0",
    "eslint": "^9.25.0",
    "eslint-import-resolver-typescript": "^4.3.3",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "source-map": "^0.7.4",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "tailwindcss": "^4.1.4",
    "tempy": "^3.1.0",
    "tinybench": "^4.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.1.1"
  },
  "keywords": [],
  "author": "acheronfail",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@tootallnate/nacp": "^0.2.0",
    "@tootallnate/nro": "^0.1.2",
    "@vscode/sudo-prompt": "^9.3.1",
    "chalk": "^5.4.1",
    "chs": "^1.1.0",
    "electron-context-menu": "^4.0.5",
    "electron-squirrel-startup": "^1.0.1",
    "gpt": "^3.0.0",
    "heroicons-svelte": "^2.0.2",
    "js-fatfs": "^0.2.1",
    "marked": "^15.0.8",
    "mbr": "^1.1.3",
    "pretty-bytes": "^6.1.1",
    "svelte-easy-crop": "^4.0.1",
    "zod": "^3.24.3"
  }
}
