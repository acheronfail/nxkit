{
  "name": "haccrypto",
  "version": "5.0.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "build/js/index.esm.js",
  "gypfile": true,
  "keywords": [
    "switch",
    "nx",
    "haccrypto",
    "nand",
    "emmc"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "test": "vitest --config vitest.config.ts",
    "build": "npm run clean && npm run build:cpp && npm run build:cjs && npm run build:esm",
    "build:cpp": "node-gyp configure && node-gyp build",
    "build:cjs": "esbuild --outfile=build/js/index.cjs --format=cjs index.ts",
    "build:esm": "esbuild --outfile=build/js/index.esm.js --format=esm index.ts",
    "prepare": "npm run build && vitest run --config vitest.config.ts",
    "clean": "rm -rf build"
  },
  "files": [
    "README.md",
    "binding.gyp",
    "build/js/*",
    "index.ts",
    "xtsn.cpp"
  ],
  "devDependencies": {
    "@types/node": "^22.14.1",
    "esbuild": "^0.25.2",
    "node-gyp": "^11.2.0",
    "vitest": "^3.1.1"
  }
}
